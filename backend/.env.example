# TravelMate Backend Environment Variables (Optional)

# OpenWeatherMap API Key (optional)
# If provided, real-time weather will be fetched from OpenWeatherMap.
# If omitted, TravelMate automatically falls back to Open-Meteo with no API key required.
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Database Configuration (optional, default SQLite embedded travelmate.db)
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DB=travelmate_db
